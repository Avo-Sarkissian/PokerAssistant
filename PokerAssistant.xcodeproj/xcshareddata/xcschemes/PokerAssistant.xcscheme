      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <Testables>
         <!-- THIS ACTION DOES NOT RUN THE ENGINE'S TESTS.
              46 of the project's 54 tests live in the PokerCoreTests SwiftPM target.
              Xcode will not resolve a package test target as a testable from a
              project-based scheme (there is no PokerCoreTests scheme either, and an
              explicit TestableReference for it is silently dropped rather than
              rejected), so this action covers only the 8 tests that genuinely need a
              simulator. Run ./scripts/test to run both suites — that is what CI does. -->
         <TestableReference
            skipped = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "D3A410262E357FA60057378A"
               BuildableName = "PokerAssistantTests.xctest"
               BlueprintName = "PokerAssistantTests"
               ReferencedContainer = "container:PokerAssistant.xcodeproj">
            </BuildableReference>
         </TestableReference>
         <!-- The UI test target is a stub and is deliberately not part of the
              default test run. -->
         <TestableReference
            skipped = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "D3A410302E357FA60057378A"
