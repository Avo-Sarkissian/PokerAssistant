#!/bin/bash
#
# Run the whole test suite.
#
# It takes two commands, not one. The engine lives in Packages/PokerCore and its
# tests are a SwiftPM test target, which Xcode will not run from a project-based
# scheme — so `xcodebuild -scheme PokerAssistant test` and Cmd-U in Xcode cover only
# the tests that genuinely need a simulator or Metal. The larger half, including
# every hand evaluation, equity, range and solver assertion, only runs through
# `swift test`. No counts here on purpose: a stale number is worse than none.
#
# Use this script rather than either command on its own. CI runs the same two steps.
#
# Usage:  ./scripts/test            both suites
#         ./scripts/test core       the engine only (fast: no simulator)
#         ./scripts/test app        the simulator-bound tests only
#         ./scripts/test anchors    the exhaustive external anchors
#
# `anchors` is deliberately not part of `all`. It is every check here against numbers
# this repository did not produce that is too expensive to run on every edit: the
# C(52,7) category census, and the classic hand-versus-hand matchups enumerated over all
# 1,712,304 boards. Together ~55s in release and sixteen times that in debug, so it
# builds release and runs on demand. Both leave a cheap sampled or theorem-shaped
# version behind in the fast loop; neither is the proof.

set -euo pipefail
cd "$(dirname "$0")/.."

WHICH="${1:-all}"

# Prefer whatever the developer already has booted — the device names available differ
# between machines and CI, and a hard-coded name is the usual reason this script fails
# on someone else's laptop. POKER_TEST_DESTINATION overrides; CI sets it.
#
# Every fallback resolves to a device *id*, never a name. The last version ended at
# `name=iPhone 16 Pro`, which stopped existing when this machine's simulators were
# updated: xcodebuild then printed its whole 60-line device list and exited, which reads
# like a project failure rather than a missing simulator. An installed-but-not-booted
# device is the normal state, so it has to be part of the search rather than the error.
pick_destination() {
    if [ -n "${POKER_TEST_DESTINATION:-}" ]; then
        echo "$POKER_TEST_DESTINATION"
        return
    fi
    local udid=""
    # In order: a booted iPhone, any booted device, then an installed iPhone, then any
    # installed device. `available` excludes runtimes Xcode cannot actually launch.
    for filter in "booted iPhone" "booted any" "available iPhone" "available any"; do
        local state="${filter% *}" want="${filter#* }" list
        list=$(xcrun simctl list devices "$state" 2>/dev/null || true)
        [ "$want" = "any" ] || list=$(printf '%s\n' "$list" | grep "$want" || true)
        udid=$(printf '%s\n' "$list" \
               | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' \
               | head -1)
        [ -n "$udid" ] && break
    done

    if [ -n "$udid" ]; then
        echo "platform=iOS Simulator,id=$udid"
    else
        echo "NO_SIMULATOR"
    fi
}

run_core() {
    echo "==> PokerCore (no simulator)"
    swift test --package-path Packages/PokerCore
}

run_anchors() {
    echo "==> External anchors: category census and head-to-head matchups (release, no simulator)"
    POKER_EXTERNAL_ANCHORS=1 swift test -c release --package-path Packages/PokerCore \
        --filter 'CategoryCensusTests|PublishedMatchupTests'
}

run_app() {
    # Resolved here rather than at the top of the script: `core` and `anchors` both
    # advertise themselves as needing no simulator, and running `xcrun simctl list`
    # four times before dispatching made that untrue.
    local DESTINATION
    DESTINATION="$(pick_destination)"
    if [ "$DESTINATION" = "NO_SIMULATOR" ]; then
        echo "==> PokerAssistantTests: no iOS Simulator is installed." >&2
        echo "    Install one in Xcode, or set POKER_TEST_DESTINATION." >&2
        exit 1
    fi
    echo "==> PokerAssistantTests (simulator: $DESTINATION)"
    xcodebuild \
        -project PokerAssistant.xcodeproj \
        -scheme PokerAssistant \
        -destination "$DESTINATION" \
        -only-testing:PokerAssistantTests \
        test
}

case "$WHICH" in
    core)    run_core ;;
    app)     run_app ;;
    # `census` kept as an alias: it was the name for one commit, and the anchors pass is
    # a superset of what it ran.
    anchors|census) run_anchors ;;
    all)     run_core; run_app ;;
    *)       echo "usage: $0 [all|core|app|anchors]" >&2; exit 2 ;;
esac

echo "==> all requested suites passed"
